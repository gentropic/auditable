/works.html
/works-core.html
/works-all.html
/editions/*.html
# First-party package catalog — generated by `node build.js --target=packages`,
# emitted to the deploy (auditable hosts its own .gcupkg artifacts + registry.json).
/packages/
examples/**/*.html
examples/**/*.recovery.txt

