{
  "name": "auditable-workspace",
  "version": "0.6.5",
  "private": true,
  "workspaces": [
    "ext/*"
  ],
  "bin": {
    "atrac": "./ext/atra/atrac.js"
  },
  "imports": {
    "#dialog": "./ext/dialog/index.js",
    "#ipynb": "./ext/ipynb/index.js",
    "#menu": "./ext/menu/index.js",
    "#term": "./ext/term/src/index.js"
  },
  "scripts": {
    "build": "node build.js",
    "build:works": "node build.js && node build.js --target=works",
    "build:gcu-press": "node ext/gcu-press/build.js && node build.js --target=gcu-press",
    "build:rv": "node ext/rv/build.js && node build.js --target=rv",
    "test": "node --no-warnings --test --test-force-exit \"test/!(adder-wasm).test.*\"",
    "test:wasm": "node --no-warnings --test-force-exit test/adder-wasm.test.mjs",
    "test:examples": "node test/examples-smoke.mjs",
    "test:micro": "node test/micro-smoke.mjs",
    "test:micro2": "node test/micro-smoke2.mjs",
    "test:micro:all": "npm run test:micro && npm run test:micro2",
    "test:wuffle": "node test/wuffle-smoke.mjs",
    "test:wuffle:bench": "node test/wuffle-bench-smoke.mjs",
    "test:gnsslog": "node test/gnsslog-smoke.mjs",
    "test:idb-browser": "node test/vfs-idb-browser.mjs",
    "test:all": "npm test && npm run test:wasm",
    "test:plan": "node build.js --target=plan && node test/plan-smoke.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "fake-indexeddb": "^6.2.5",
    "js-yaml": "^4.1.1",
    "ol": "^10.8.0",
    "playwright": "^1.59.1",
    "proj4": "^2.20.3",
    "rollup": "^4.59.0"
  }
}
