% micro.sty — the design system of the micro manual (LuaLaTeX).
% GCU Switchboard on paper: Barlow (text), Barlow Semi Condensed (display), Space Mono (code, keys,
% file names); the amber accent and the semantic colours of micro's light theme; basalt (micro's dark
% interface) for part pages and chapter openers.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{micro}[2026/11/22 micro manual design]

\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage[a4paper, inner=24mm, outer=58mm, top=26mm, bottom=30mm, marginparwidth=40mm, marginparsep=6mm, headsep=10mm, footskip=14mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\RequirePackage[english]{babel}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, calc, fit, backgrounds, shapes.geometric, shapes.misc, decorations.pathreplacing, shadows.blur}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
% every plot in the house style: thin warm-grey axes and grid, Barlow labels, numbers in the text font
\pgfplotsset{every axis/.append style={axis lines=left, grid=major, grid style={rule!55, line width=0.3pt}, axis line style={rule, line width=0.5pt}, tick style={rule}, label style={font=\sffamily\small\color{muted}}, tick label style={font=\sffamily\footnotesize\color{muted}}, /pgf/number format/assume math mode=true, legend style={draw=none, fill=none, font=\sffamily\footnotesize\color{text}}, legend cell align=left, title style={font=\displayfont\small\color{ink}}}}
\pgfplotsset{table/col sep=tab, unbounded coords=jump}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{multicol}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{marginnote}
\RequirePackage{scrlayer-scrpage}
\RequirePackage{imakeidx}
\RequirePackage{fontawesome5}
\RequirePackage{hyperref}
\RequirePackage[nameinlink, noabbrev]{cleveref}

% ── type ──
\defaultfontfeatures{Ligatures=TeX, Scale=1.0}
% symbols the faces don't carry (⌘ ⇧ ⌥ ⏎ arrows, box drawing) come from DejaVu, shipped with TeX
\directlua{luaotfload.add_fallback("microfallback", {"DejaVuSans.ttf:mode=harf;", "DejaVuSansMono.ttf:mode=harf;", "NotoSansMath-Regular.ttf:mode=harf;"})}
\newcommand\fontdir{\detokenize{fonts/}}
\setmainfont{Barlow}[Path=\fontdir, Extension=.ttf, RawFeature={fallback=microfallback}, UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic, Numbers={Proportional,Lining}]
\setsansfont{Barlow}[Path=\fontdir, Extension=.ttf, RawFeature={fallback=microfallback}, UprightFont=*-Medium, ItalicFont=*-MediumItalic, BoldFont=*-Bold, BoldItalicFont=*-BoldItalic]
\setmonofont{SpaceMono}[Path=\fontdir, Extension=.ttf, RawFeature={fallback=microfallback}, UprightFont=*-Regular, ItalicFont=*-Italic, BoldFont=*-Bold, BoldItalicFont=*-BoldItalic, Scale=0.86, Ligatures=TeXOff]
\newfontfamily\displayfont{BarlowSemiCondensed}[Path=\fontdir, Extension=.ttf, RawFeature={fallback=microfallback}, UprightFont=*-SemiBold, BoldFont=*-Bold]
\newfontfamily\displaylight{BarlowSemiCondensed}[Path=\fontdir, Extension=.ttf, RawFeature={fallback=microfallback}, UprightFont=*-Light, BoldFont=*-Medium]
\newfontfamily\numfont{Barlow}[Path=\fontdir, Extension=.ttf, UprightFont=*-Light, Numbers={Lining,Monospaced}]
\setmathfont{latinmodern-math.otf}[Scale=MatchLowercase]
\linespread{1.12}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em plus 0.15em minus 0.1em}
\frenchspacing
\raggedbottom

% ── colour (micro's light theme; basalt from its dark one) ──
\definecolor{ink}{HTML}{232322}
\definecolor{text}{HTML}{3A3936}
\definecolor{muted}{HTML}{5F5D5A}
\definecolor{faint}{HTML}{8A8883}
\definecolor{rule}{HTML}{C9C7C2}
\definecolor{paper}{HTML}{FBFAF8}
\definecolor{tint}{HTML}{F1EFEB}
\definecolor{amber}{HTML}{75570F}
\definecolor{amberlight}{HTML}{C89B3C}
\definecolor{ambersoft}{HTML}{ECE2C9}
\definecolor{info}{HTML}{005C97}
\definecolor{infosoft}{HTML}{DCE8F2}
\definecolor{ok}{HTML}{2F6B33}
\definecolor{oksoft}{HTML}{DDEBDD}
\definecolor{fault}{HTML}{A3352A}
\definecolor{faultsoft}{HTML}{F3DEDA}
\definecolor{caution}{HTML}{7A5200}
\definecolor{cautionsoft}{HTML}{F2E6CC}
\definecolor{sel}{HTML}{6A4FA8}
\definecolor{selsoft}{HTML}{E6E0F2}
\definecolor{basalt}{HTML}{161616}
\definecolor{basalt2}{HTML}{242424}
\definecolor{basalttext}{HTML}{BBBBBB}
\color{text}
\hypersetup{colorlinks=true, linkcolor=amber, urlcolor=info, citecolor=amber, pdfborder={0 0 0}}

% ── headings ──
\setkomafont{disposition}{\displayfont\color{ink}}
\setkomafont{part}{\displayfont\Huge\color{white}}
\setkomafont{partnumber}{\displaylight\huge\color{amberlight}}
\setkomafont{chapter}{\displayfont\fontsize{30}{34}\selectfont}
\setkomafont{section}{\displayfont\Large}
\setkomafont{subsection}{\displayfont\large}
\setkomafont{subsubsection}{\displayfont\normalsize\color{amber}}
\setkomafont{paragraph}{\sffamily\bfseries\color{ink}}
\setkomafont{pageheadfoot}{\sffamily\footnotesize\color{muted}}
\setkomafont{pagenumber}{\numfont\small\color{amber}}
\setkomafont{caption}{\small\color{muted}}
\setkomafont{captionlabel}{\sffamily\bfseries\small\color{amber}}
\RedeclareSectionCommand[beforeskip=-1.6\baselineskip, afterskip=0.5\baselineskip]{section}
\RedeclareSectionCommand[beforeskip=-1.2\baselineskip, afterskip=0.35\baselineskip]{subsection}
\RedeclareSectionCommand[beforeskip=-0.9\baselineskip, afterskip=0.25\baselineskip]{subsubsection}
\renewcommand*{\sectionformat}{\textcolor{amber}{\thesection}\hspace{0.7em}}
\renewcommand*{\subsectionformat}{\textcolor{amber!70}{\thesubsection}\hspace{0.6em}}

% chapter opener: a basalt band across the top with the number in amber, the title below
% every chapter (numbered or not) starts under a basalt band; a numbered one carries its number in it
\renewcommand*{\chapterheadstartvskip}{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[basalt] (current page.north west) rectangle ([yshift=-38mm]current page.north east);
    \fill[amberlight] ([yshift=-38mm]current page.north west) rectangle ([yshift=-39.2mm]current page.north east);
  \end{tikzpicture}\vspace*{14mm}}
\renewcommand*{\chapterformat}{%
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=south east, inner sep=0pt, text=amberlight, font=\numfont\fontsize{64}{64}\selectfont]
      at ([xshift=-58mm, yshift=-33mm]current page.north east) {\thechapter};
    \node[anchor=south west, inner sep=0pt, text=basalttext, font=\displaylight\small]
      at ([xshift=24mm, yshift=-33mm]current page.north west) {CHAPTER};
  \end{tikzpicture}}
\RedeclareSectionCommand[beforeskip=0pt, afterskip=1.6\baselineskip]{chapter}

% part page: a full basalt page
\renewcommand*{\partformat}{\partname~\thepart}
\renewcommand*{\partlineswithprefixformat}[3]{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[basalt] (current page.south west) rectangle (current page.north east);
    \fill[amberlight] ([xshift=24mm, yshift=-118mm]current page.north west) rectangle ([xshift=44mm, yshift=-119.4mm]current page.north west);
    \node[anchor=north west, inner sep=0pt, text width=120mm, align=left] at ([xshift=24mm, yshift=-92mm]current page.north west) {#2};
    \node[anchor=north west, inner sep=0pt, text width=130mm, align=left] at ([xshift=24mm, yshift=-126mm]current page.north west) {#3};
  \end{tikzpicture}}
\renewcommand*{\partpagestyle}{empty}

% running heads
\pagestyle{scrheadings}
\clearpairofpagestyles
\automark[section]{chapter}
\ohead{\leftmark}
\ofoot{\pagemark}
\setlength{\footheight}{14pt}
\renewcommand*{\chaptermarkformat}{\textcolor{amber}{\thechapter}\enskip}
\renewcommand*{\sectionmarkformat}{}
\addtokomafont{pagehead}{\upshape}

% ── inline vocabulary ──
% robust: these appear in captions and section titles (moving arguments)
\DeclareRobustCommand\key[1]{\tikz[baseline=(k.base)]\node[draw=rule, fill=tint, rounded corners=1.6pt, inner xsep=2.6pt, inner ysep=1.2pt, line width=0.5pt, font=\ttfamily\footnotesize\color{ink}](k){\strut#1};}
\newcommand\keys[1]{\begingroup\def\+{\,}\key{#1}\endgroup}
\ExplSyntaxOn
\NewDocumentCommand\menu{m}{\group_begin:\sffamily\color{ink}\seq_set_split:Nnn\l_tmpa_seq{>}{#1}\seq_use:Nn\l_tmpa_seq{\,\textcolor{amber}{\scriptsize\faChevronRight}\,}\group_end:}
\ExplSyntaxOff
\DeclareRobustCommand\ui[1]{{\sffamily\color{ink}#1}}
\DeclareRobustCommand\file[1]{{\ttfamily\color{ink}#1}}
\DeclareRobustCommand\code[1]{{\ttfamily\color{ink}#1}}
\DeclareRobustCommand\col[1]{{\ttfamily\color{amber}#1}}
\newcommand\term[1]{\emph{#1}\index{#1}}
\newcommand\new[1]{\textcolor{amber}{\sffamily\bfseries\scriptsize\MakeUppercase{#1}}}

% margin notes: keys and pointers in the outer column
\newcommand\side[1]{\marginnote{\raggedright\footnotesize\sffamily\color{muted}#1}}
\newcommand\sidekey[2]{\marginnote{\raggedright\footnotesize\sffamily\color{muted}\key{#1}\par\smallskip #2}}

% ── boxes ──
\tcbset{microbox/.style={enhanced, breakable, boxrule=0pt, arc=1.5pt, left=4mm, right=4mm, top=2.2mm, bottom=2.2mm, before skip=0.9em, after skip=0.9em, fonttitle=\sffamily\bfseries\small, coltitle=ink, attach title to upper={\enskip}}}
\newtcolorbox{tip}[1][]{microbox, colback=oksoft, borderline west={2.4pt}{0pt}{ok}, title={\textcolor{ok}{\faLightbulb[regular]}\enskip Tip}, #1}
\newtcolorbox{note}[1][]{microbox, colback=infosoft, borderline west={2.4pt}{0pt}{info}, title={\textcolor{info}{\faInfoCircle}\enskip Note}, #1}
\newtcolorbox{caution}[1][]{microbox, colback=cautionsoft, borderline west={2.4pt}{0pt}{caution}, title={\textcolor{caution}{\faExclamationTriangle}\enskip Careful}, #1}
\newtcolorbox{why}[1][]{microbox, colback=tint, borderline west={2.4pt}{0pt}{faint}, title={\textcolor{muted}{\faQuestionCircle[regular]}\enskip Why it works this way}, #1}
% a tutorial step: numbered, violet (micro's "selected")
\newcounter{trystep}[chapter]
\newtcolorbox{tryit}[1][]{enhanced, breakable, boxrule=0.6pt, colframe=sel!45, colback=selsoft!45, arc=2pt, left=4mm, right=4mm, top=2.5mm, bottom=2.5mm, before skip=1em, after skip=1em,
  fonttitle=\sffamily\bfseries\small, coltitle=sel, title={\stepcounter{trystep}\faHandPointRight[regular]\enskip Try it \thetrystep}, attach boxed title to top left={xshift=3mm, yshift*=-2.2mm}, boxed title style={colback=white, colframe=sel!45, boxrule=0.6pt, arc=2pt}, #1}
% what a reader gets out of a chapter
\newtcolorbox{goals}{enhanced, boxrule=0pt, colback=ambersoft!55, arc=1.5pt, left=4mm, right=4mm, top=2.5mm, bottom=2.5mm, before skip=0.4em, after skip=1.2em, fontupper=\small}

% ── code (listings: builds on any TeX install; Unicode is native under LuaLaTeX) ──
\lstdefinestyle{micro}{basicstyle=\ttfamily\small\color{ink}, backgroundcolor=\color{tint}, frame=single, rulecolor=\color{tint}, framesep=2.2mm, xleftmargin=2.4mm, xrightmargin=2.4mm, aboveskip=1em, belowskip=0.8em, breaklines=true, breakatwhitespace=true, columns=fullflexible, keepspaces=true, showstringspaces=false, upquote=true, tabsize=2,
  keywordstyle=\color{info}\bfseries, stringstyle=\color{ok}, commentstyle=\color{faint}\itshape, identifierstyle=\color{ink}, extendedchars=true}
\lstdefinelanguage{yaml}{morekeywords={true,false,null}, sensitive=true, morecomment=[l]{\#}, morestring=[b]", morestring=[b]', alsoletter={-_}}
\lstdefinelanguage{expr}{morekeywords={and,or,not,in,between,like,is,null,true,false,if,then,else}, sensitive=false, morestring=[b]", morestring=[b]', morecomment=[l]{--}}
\lstdefinelanguage{js}{morekeywords={const,let,var,await,async,function,return,new,if,else,for,of,in,true,false,null,undefined}, sensitive=true, morecomment=[l]{//}, morestring=[b]", morestring=[b]'}
\lstset{style=micro}

% ── figures ──
\newcommand\shot[3][\linewidth]{% \shot[width]{file}{caption}
  \begin{figure}[htbp]\centering
  \IfFileExists{figures/shots/#2.png}{%
  \begin{tikzpicture}\node[inner sep=0pt, drop shadow={opacity=0.22, shadow xshift=0.6mm, shadow yshift=-0.8mm}]{\includegraphics[width=#1]{#2}};\end{tikzpicture}}{%
  \begin{tikzpicture}\node[draw=rule, dashed, fill=tint, minimum width=#1, minimum height=0.5\dimexpr#1\relax, font=\sffamily\small\color{muted}, align=center]{screenshot pending\\\texttt{#2}};\end{tikzpicture}\typeout{(screenshot #2 pending)}}%
  \caption{#3}\label{fig:#2}\end{figure}}
\captionsetup{format=plain, labelsep=quad, justification=raggedright, singlelinecheck=false, skip=6pt}
\graphicspath{{figures/}{figures/shots/}}

% lists
\setlist{itemsep=0.25em, topsep=0.35em, parsep=0pt}
\setlist[itemize]{label=\textcolor{amber}{\scriptsize\raisebox{0.15ex}{\faSquare}}, leftmargin=1.4em}
\setlist[enumerate]{label=\textcolor{amber}{\sffamily\bfseries\arabic*}, leftmargin=1.6em}
\setlist[description]{font=\sffamily\bfseries\color{ink}}

% tables
\renewcommand{\arraystretch}{1.18}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}

\makeindex[intoc, columns=2, title=Index]
\endinput
