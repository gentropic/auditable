% chapter opener: a basalt band across the top with the number in amber, the title below
% every chapter (numbered or not) starts under a basalt band; a numbered one carries its number in it
\renewcommand*{\chapterformat}{%
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=south east, inner sep=0pt, text=amberlight, font=\numfont\fontsize{64}{64}\selectfont]
      at ([xshift=-58mm, yshift=-33mm]current page.north east) {\thechapter};
    \node[anchor=south west, inner sep=0pt, text=basalttext, font=\displaylight\small]
      at ([xshift=24mm, yshift=-33mm]current page.north west) {CHAPTER};
  \end{tikzpicture}}
\RedeclareSectionCommand[beforeskip=0pt, afterskip=1.6\baselineskip]{chapter}
% an UNNUMBERED chapter (the preface, References, the index) has no number line pushing its title below
% the 38 mm band — it sat in it, dark on basalt. KOMA keeps spacing at the top of a page out of reach
% (\IfUseNumber isn't allowed here, beforeskip is discarded at a page top), so such a chapter gets a
% SHORTER band instead — it carries no number to hold. \chapter* raises the flag (the wrapper below).
\newif\ifwufflestarchapter
\renewcommand*{\chapterheadstartvskip}{%
  \begin{tikzpicture}[remember picture, overlay]
    \ifwufflestarchapter\def\wuffleband{20mm}\else\def\wuffleband{38mm}\fi
    \fill[basalt] (current page.north west) rectangle ([yshift=-\wuffleband]current page.north east);
    \fill[amberlight] ([yshift=-\wuffleband]current page.north west) rectangle ([yshift=-\wuffleband-1.2mm]current page.north east);
  \end{tikzpicture}\vspace*{14mm}}
\NewCommandCopy\wuffleOrigChapter\chapter
\RenewDocumentCommand\chapter{s o m}{%
  \IfBooleanTF{#1}%
    {\wufflestarchaptertrue\wuffleOrigChapter*{#3}\wufflestarchapterfalse}%
    {\IfValueTF{#2}{\wuffleOrigChapter[#2]{#3}}{\wuffleOrigChapter{#3}}}}

% part page: a full basalt page
