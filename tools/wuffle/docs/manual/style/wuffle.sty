\DeclareRobustCommand\ui[1]{\leavevmode{\sffamily\color{ink}#1}}
% \file, \code and \col may break after / . _ , = : and before a bracket (style/wufflebreak.lua): the
% code face doesn't hyphenate, and a long path had nowhere to go but the margin
\newattribute\wufflecode
\directlua{dofile(kpse.find_file('style/wufflebreak.lua') or 'style/wufflebreak.lua')}
