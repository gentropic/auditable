% wuffle.sty — the design system of the wuffle manual (LuaLaTeX).
% A FORK of the micro manual's style (tools/micro/docs/manual/style/micro.sty, 2026-11-26) with the names
% changed: same page, same boxes, same hard-won page-break patches. When a third GCU manual comes, the
% two should become one shared style instead of a third copy.
% GCU Switchboard on paper: Barlow (text), Barlow Semi Condensed (display), Space Mono (code, keys,
% file names); the amber accent and the semantic colours of the Switchboard light theme; basalt (the
% dark theme) for part pages and chapter openers.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wuffle}[2026/11/26 wuffle manual design]

\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage[a4paper, inner=24mm, outer=58mm, top=26mm, bottom=30mm, marginparwidth=40mm, marginparsep=6mm, headsep=10mm, footskip=14mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\RequirePackage[english]{babel}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, calc, fit, backgrounds, shapes.geometric, shapes.misc, decorations.pathreplacing, shadows.blur}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
% every plot in the house style: thin warm-grey axes and grid, Barlow labels, numbers in the text font
\pgfplotsset{every axis/.append style={axis lines=left, grid=major, grid style={rule!55, line width=0.3pt}, axis line style={rule, line width=0.5pt}, tick style={rule}, label style={font=\sffamily\small\color{muted}}, tick label style={font=\sffamily\footnotesize\color{muted}}, /pgf/number format/assume math mode=true, legend style={draw=none, fill=none, font=\sffamily\footnotesize\color{text}}, legend cell align=left, title style={font=\displayfont\small\color{ink}}}}
\pgfplotsset{table/col sep=tab, unbounded coords=jump}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{xltabular}   % a table in running text may break across pages (see "tables" below)
\RequirePackage{adjustbox}   % a diagram a little wider than the measure scales to fit it
\RequirePackage{array}
\RequirePackage{multicol}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{marginnote}
\RequirePackage{scrlayer-scrpage}
\RequirePackage{imakeidx}
\RequirePackage{fontawesome5}
% references: author–year, biber; references.bib beside the main file
\RequirePackage{csquotes}
\RequirePackage[backend=biber, style=authoryear-comp, maxcitenames=2, maxbibnames=99, uniquename=false, uniquelist=false, giveninits=true, dashed=false, doi=true, url=true, isbn=false, eprint=false]{biblatex}
\addbibresource{references.bib}
\RequirePackage{hyperref}
\RequirePackage[nameinlink, noabbrev]{cleveref}

