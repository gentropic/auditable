\DeclareRobustCommand\code[1]{\leavevmode{\setattribute\wufflecode{1}\ttfamily\color{ink}#1}}
\DeclareRobustCommand\col[1]{\leavevmode{\setattribute\wufflecode{1}\ttfamily\color{amber}#1}}
