% ── code (listings: builds on any TeX install; Unicode is native under LuaLaTeX) ──
\lstdefinestyle{wuffle}{basicstyle=\ttfamily\small\color{ink}, backgroundcolor=\color{tint}, frame=single, rulecolor=\color{tint}, framesep=2.2mm, xleftmargin=2.4mm, xrightmargin=2.4mm, aboveskip=1em, belowskip=0.8em, breaklines=true, breakatwhitespace=true, columns=fullflexible, keepspaces=true, showstringspaces=false, upquote=true, tabsize=2,
  keywordstyle=\color{info}\bfseries, stringstyle=\color{ok}, commentstyle=\color{faint}\itshape, identifierstyle=\color{ink}, extendedchars=true}
% CODE BLOCKS are NOT listings: listings gathers letters and digits into tokens and emits a non-ASCII
% character before the pending token, so `pole 207→01` printed as `pole →20701` and `● Sets` lost its
% bullet to the line before — wrong numbers in a manual. (A `literate` map doesn't help: the replacement
% is emitted early too.) fancyvrb + fvextra set the text as it is, Unicode and all, under LuaLaTeX, and
% break long lines at spaces. \begin{codeblock} … \end{codeblock}; codeblocktiny for a wide table of
% data. (No optional argument: its look-ahead eats the line end, and Verbatim then reads the first code
% line as junk after \begin.)
\RequirePackage{fvextra}
\newtcolorbox{wufflecodebox}{enhanced, breakable, boxrule=0pt, colback=tint, arc=1.5pt, left=2.4mm, right=2.4mm, top=1.8mm, bottom=1.8mm, before skip=1em, after skip=0.8em}
\fvset{formatcom=\color{ink}, breaklines=true, breaksymbolleft={}, breakindent=1.6em}
\newenvironment{codeblock}
  {\VerbatimEnvironment\begin{wufflecodebox}\begin{Verbatim}[fontsize=\small]}
  {\end{Verbatim}\end{wufflecodebox}}
\newenvironment{codeblocktiny}
  {\VerbatimEnvironment\begin{wufflecodebox}\begin{Verbatim}[fontsize=\tiny]}
  {\end{Verbatim}\end{wufflecodebox}}
\AddToHook{env/codeblocktiny/before}{\wuffleneed{4}}
\lstdefinelanguage{yaml}{morekeywords={true,false,null}, sensitive=true, morecomment=[l]{\#}, morestring=[b]", morestring=[b]', alsoletter={-_}}
\lstdefinelanguage{expr}{morekeywords={and,or,not,in,between,like,is,null,true,false,if,then,else}, sensitive=false, morestring=[b]", morestring=[b]', morecomment=[l]{--}}
\lstdefinelanguage{js}{morekeywords={const,let,var,await,async,function,return,new,if,else,for,of,in,true,false,null,undefined}, sensitive=true, morecomment=[l]{//}, morestring=[b]", morestring=[b]'}
\lstset{style=wuffle}

% ── figures ──
% a tall screenshot is capped at 0.8 of the text height, so it and its caption always fit one page
% the build's print copy (figures/print/, JPEG or PNG at print resolution) wins over the 2× capture
\newcommand\shotfile{}
\newcommand\shot[3][\linewidth]{% \shot[width]{file}{caption}
  \begin{figure}[htbp]\centering
  \IfFileExists{figures/print/#2.jpg}{\renewcommand\shotfile{figures/print/#2.jpg}}{%
  \IfFileExists{figures/print/#2.png}{\renewcommand\shotfile{figures/print/#2.png}}{%
  \renewcommand\shotfile{figures/shots/#2.png}}}%
  \IfFileExists{\shotfile}{%
  \begin{tikzpicture}\node[inner sep=0pt, drop shadow={opacity=0.22, shadow xshift=0.6mm, shadow yshift=-0.8mm}]{\includegraphics[width=#1, height=0.8\textheight, keepaspectratio]{\shotfile}};\end{tikzpicture}}{%
  \begin{tikzpicture}\node[draw=rule, dashed, fill=tint, minimum width=#1, minimum height=0.5\dimexpr#1\relax, font=\sffamily\small\color{muted}, align=center]{screenshot pending\\\texttt{#2}};\end{tikzpicture}\typeout{(screenshot #2 pending)}}%
  \caption{#3}\label{fig:#2}\end{figure}}
\captionsetup{format=plain, labelsep=quad, justification=raggedright, singlelinecheck=false, skip=6pt}
\graphicspath{{figures/}{figures/shots/}}

% lists
\setlist{itemsep=0.25em, topsep=0.35em, parsep=0pt}
\setlist[itemize]{label=\textcolor{amber}{\scriptsize\raisebox{0.15ex}{\faSquare}}, leftmargin=1.4em}
