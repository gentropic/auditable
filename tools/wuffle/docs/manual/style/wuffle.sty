    \fill[amberlight] ([xshift=24mm, yshift=-118mm]current page.north west) rectangle ([xshift=44mm, yshift=-119.4mm]current page.north west);
    \node[anchor=north west, inner sep=0pt, text width=120mm, align=left] at ([xshift=24mm, yshift=-92mm]current page.north west) {#2};
    \node[anchor=north west, inner sep=0pt, text width=130mm, align=left] at ([xshift=24mm, yshift=-126mm]current page.north west) {#3};
  \end{tikzpicture}}
