{
  "name": "@gcu/plot",
  "version": "0.2.0",
  "description": "matplotlib for the browser: plot, scatter, bar, hist, boxplot, imshow, contour(f), pcolormesh, errorbar, fill_between, norms and colorbars, themes. Canvas 2D, zero runtime dependencies, strict-CSP safe.",
  "type": "module",
  "main": "src/api.js",
  "exports": {
    ".": "./src/api.js",
    "./axes": "./src/axes.js",
    "./color": "./src/color.js",
    "./figure": "./src/figure.js",
    "./scale": "./src/scale.js",
    "./format": "./src/format.js",
    "./bundled": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.js",
    "index.d.ts",
    "API.md",
    "llms.txt",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node build.js"
  },
  "keywords": [
    "plot",
    "plotting",
    "chart",
    "matplotlib",
    "canvas",
    "visualization",
    "auditable",
    "gcu"
  ],
  "license": "MIT",
  "author": "Arthur Endlein Correia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentropic/auditable.git",
    "directory": "ext/plot"
  },
  "homepage": "https://github.com/gentropic/auditable/tree/main/ext/plot",
  "bugs": {
    "url": "https://github.com/gentropic/auditable/issues"
  },
  "auditable": {
    "kind": "extension",
    "exampleOf": "library pack — declares gcu.adderExports so adder code (`import plt`) resolves it offline once installed; registers its `plt` export on load."
  },
  "gcu": {
    "adderExports": [
      "plt"
    ]
  },
  "types": "./index.d.ts"
}
