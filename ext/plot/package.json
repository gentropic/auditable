{
  "name": "@gcu/plot",
  "version": "0.2.0",
  "description": "matplotlib for the browser: plot, scatter, bar, hist, boxplot, violinplot, hexbin, hist2d, stackplot, imshow, contour(f), pcolormesh, errorbar, fill_between, norms and colorbars, tick formatters, date axes, themes. Canvas 2D, zero runtime dependencies, strict-CSP safe.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./svg": {
      "types": "./svg.d.ts",
      "default": "./src/svg.js"
    },
    "./interact": {
      "types": "./interact.d.ts",
      "default": "./src/interact.js"
    },
    "./axes": "./index.js",
    "./figure": "./index.js",
    "./color": "./src/color.js",
    "./scale": "./src/scale.js",
    "./format": "./src/format.js",
    "./bundled": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.js",
    "index.d.ts",
    "API.md",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "svg.d.ts",
    "interact.d.ts"
  ],
  "scripts": {
    "build": "node build.js"
  },
  "keywords": [
    "plot",
    "plotting",
    "chart",
    "matplotlib",
    "canvas",
    "visualization",
    "auditable",
    "gcu"
  ],
  "license": "MIT",
  "author": "Arthur Endlein Correia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentropic/auditable.git",
    "directory": "ext/plot"
  },
  "homepage": "https://github.com/gentropic/auditable/tree/main/ext/plot",
  "bugs": {
    "url": "https://github.com/gentropic/auditable/issues"
  },
  "auditable": {
    "kind": "extension",
    "exampleOf": "library pack — declares gcu.adderExports so adder code (`import plt`) resolves it offline once installed; registers its `plt` export on load."
  },
  "gcu": {
    "adderExports": [
      "plt"
    ]
  },
  "types": "./index.d.ts"
}
