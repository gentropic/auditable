    "src",
    "index.js",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js"
  },
  "dependencies": {
    "@gcu/bearing": "*",
    "@gcu/geometry": "*"
  },
  "keywords": [
    "structural-geology",
    "outcrop",
    "attitude",
    "dip",
    "fracture",
    "mesh",
    "geodesic",
    "auditable",
    "gcu"
  ],
  "license": "MIT",
  "author": "Arthur Endlein Correia",
