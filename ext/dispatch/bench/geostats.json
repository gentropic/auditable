    {
      "prep": "from",
      "mod": "run",
      "heads": [
        "blockmodel",
        "variogram",
        "search"
      ],
      "attr": "run",
      "byName": true
    },
    {
      "prep": "above",
      "quantity": true,
      "heads": [
        "samples",
        "composites",
        "variable"
      ],
      "attr": "above"
    },
    {
      "prep": "below",
      "quantity": true,
      "heads": [
        "samples",
        "composites",
        "variable"
      ],
      "attr": "below"
    }
  ],
