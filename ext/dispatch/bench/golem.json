{
  "$comment": "clause ontology for golem's reading register: conversions, lookups, plots, definitions, lists, a few device and session verbs. Most of golem's queries are bare noun phrases or closed questions, so most frames are `elidable`: they bind without a verb. The grammar reads; the tool checks (a conversion between unrelated dimensions parses fine and is refused downstream). Sample vocabulary only — the real nouns come from packs.",
  "nouns": [
    { "type": "variable", "needsId": true,
      "words": { "Cu": ["cu", "copper"], "Au": ["au", "gold"] }, "generic": ["grade", "grades", "column", "columns"],
      "words_pt": { "Cu": ["cu", "cobre"], "Au": ["au", "ouro"] }, "generic_pt": ["teor", "teores", "coluna", "colunas"] },
    { "type": "plot",
      "words": { "histogram": ["histogram", "hist"], "variogram": ["variogram"] }, "generic": ["plot", "chart"],
      "words_pt": { "histogram": ["histograma"], "variogram": ["variograma"] }, "generic_pt": ["gráfico", "grafico"] },
    { "type": "mineral",
      "words": { "chalcopyrite": ["chalcopyrite"], "pyrite": ["pyrite"], "galena": ["galena"], "quartz": ["quartz"], "calcite": ["calcite"], "magnetite": ["magnetite"] },
      "generic": ["mineral", "minerals", "rock", "sample"],
      "words_pt": { "chalcopyrite": ["calcopirita"], "pyrite": ["pirita"], "galena": ["galena"], "quartz": ["quartzo"], "calcite": ["calcita"], "magnetite": ["magnetita"] },
      "generic_pt": ["mineral", "minerais", "rocha", "amostra"] },
    { "type": "country",
      "words": { "Mongolia": ["mongolia"], "Chile": ["chile"], "Brazil": ["brazil"], "Zambia": ["zambia"], "Kazakhstan": ["kazakhstan"], "Peru": ["peru"] },
      "generic": ["country", "countries", "nation", "nations"],
      "words_pt": { "Mongolia": ["mongólia", "mongolia"], "Chile": ["chile"], "Brazil": ["brasil"], "Zambia": ["zâmbia", "zambia"], "Kazakhstan": ["cazaquistão", "cazaquistao"], "Peru": ["peru"] },
      "generic_pt": ["país", "pais", "países", "paises"] },
    { "type": "property",
      "words": { "density": ["density"], "hardness": ["hardness"], "formula": ["formula"], "streak": ["streak"], "capital": ["capital"], "population": ["population"], "area": ["area"], "population density": ["population density"] },
      "generic": ["property", "value"],
      "words_pt": { "density": ["densidade"], "hardness": ["dureza"], "formula": ["fórmula", "formula"], "streak": ["traço", "traco"], "capital": ["capital"], "population": ["população", "populacao"], "area": ["área", "area"], "population density": ["densidade populacional", "densidade de população"] },
      "generic_pt": ["propriedade", "valor"] },
    { "type": "filter",
      "words": { "landlocked": ["landlocked"] },
      "words_pt": { "landlocked": ["sem litoral", "sem costa"] } },
    { "type": "scale",
      "words": { "log": ["log", "logarithmic", "log scale"], "linear": ["linear", "linear scale"] },
      "words_pt": { "log": ["log", "logarítmica", "logaritmica", "escala log"], "linear": ["linear", "escala linear"] } },
    { "type": "term",
      "words": { "skiplist": ["skiplist", "skip list"], "hash table": ["hash table", "hashtable"], "treap": ["treap"], "b-tree": ["b-tree", "btree", "b tree"] },
      "generic": ["term", "word"],
      "words_pt": { "skiplist": ["skiplist", "skip list"], "hash table": ["hash table", "tabela hash"], "treap": ["treap"], "b-tree": ["b-tree", "btree", "árvore b", "arvore b"] },
      "generic_pt": ["termo", "palavra"] },
    { "type": "table",
      "words": { "assays.csv": ["assays.csv", "assays", "sample table"] }, "generic": ["table", "file", "csv"],
      "words_pt": { "assays.csv": ["assays.csv", "assays", "tabela de amostra"] }, "generic_pt": ["tabela", "arquivo"] },
    { "type": "format",
      "words": { "script": ["script", "python", "adder"], "notebook": ["notebook"] },
      "words_pt": { "script": ["script", "python", "adder"], "notebook": ["notebook", "caderno"] } }
  ],
  "units": [
    { "unit": "m", "dim": "length", "words": ["m", "metres", "meters", "metre", "meter"], "words_pt": ["m", "metros", "metro"] },
    { "unit": "ft", "dim": "length", "words": ["ft", "feet", "foot"], "words_pt": ["ft", "pés", "pes", "pé", "pe"] },
    { "unit": "km", "dim": "length", "words": ["km", "kilometres", "kilometers"], "words_pt": ["km", "quilômetros", "quilometros"] },
    { "unit": "mi", "dim": "length", "words": ["mi", "miles", "mile"], "words_pt": ["mi", "milhas", "milha"] },
    { "unit": "kg", "dim": "mass", "words": ["kg", "kilograms", "kilos"], "words_pt": ["kg", "quilos", "quilogramas"] },
    { "unit": "g/t", "dim": "grade", "words": ["g/t", "gpt", "grams per tonne"], "words_pt": ["g/t", "gpt", "gramas por tonelada"] },
    { "unit": "ppm", "dim": "grade", "words": ["ppm"], "words_pt": ["ppm"] },
    { "unit": "oz/st", "dim": "grade", "words": ["oz per short ton", "oz/st", "opt", "ounces per short ton"], "words_pt": ["oz por tonelada curta", "oz/st", "opt"] },
    { "unit": "%", "dim": "grade", "words": ["%", "percent", "pct"], "words_pt": ["%", "por cento", "porcento"] },
    { "unit": "g/cm3", "dim": "density", "words": ["g/cm3", "g/cc", "grams per cubic centimetre"], "words_pt": ["g/cm3", "g/cc"] },
    { "unit": "lb/ft3", "dim": "density", "words": ["lb/ft3", "pounds per cubic foot"], "words_pt": ["lb/ft3", "libras por pé cúbico"] },
    { "unit": "psi", "dim": "pressure", "words": ["psi"], "words_pt": ["psi"] },
    { "unit": "MPa", "dim": "pressure", "words": ["mpa", "megapascal", "megapascals"], "words_pt": ["mpa", "megapascal", "megapascais"] },
    { "unit": "°C", "dim": "temperature", "words": ["c", "°c", "celsius", "centigrade"], "words_pt": ["c", "°c", "celsius"] },
    { "unit": "°F", "dim": "temperature", "words": ["f", "°f", "fahrenheit"], "words_pt": ["f", "°f", "fahrenheit"] },
    { "unit": "min", "dim": "time", "words": ["min", "minutes", "minute", "mins"], "words_pt": ["min", "minutos", "minuto"] },
    { "unit": "s", "dim": "time", "words": ["s", "sec", "secs", "seconds", "second"], "words_pt": ["s", "seg", "segundos", "segundo"] },
    { "unit": "h", "dim": "time", "words": ["h", "hr", "hrs", "hours", "hour"], "words_pt": ["h", "horas", "hora"] },
    { "unit": "km2", "dim": "area", "words": ["km2", "square kilometres", "square km", "sq km"], "words_pt": ["km2", "quilômetros quadrados", "km quadrados"] },
    { "unit": "sq mi", "dim": "area", "words": ["square miles", "sq mi", "mi2"], "words_pt": ["milhas quadradas"] },
    { "unit": "people/km2", "dim": "pdensity", "words": ["people per square kilometre", "people per km2", "per km2"], "words_pt": ["pessoas por km2", "por km2", "habitantes por km2"] },
    { "unit": "people/sq mi", "dim": "pdensity", "words": ["people per square mile", "per square mile"], "words_pt": ["pessoas por milha quadrada", "por milha quadrada"] }
  ],
  "$compounds": "modifier noun + head noun; `echo` asks the echo to show the attribute as an adjective",
  "compounds": [
    { "mod": "filter", "heads": ["country"], "attr": "filter", "echo": true },
    { "mod": "scale", "heads": ["plot"], "attr": "scale", "echo": true }
  ],
  "postmods": [],
  "qmods": [],
  "$verbs": "`elidable` frames bind a bare theme with no verb said; the tool behind each decides whether the reading can be answered",
  "verbs": [
    { "name": "convert", "label": "Convert", "words": ["convert", "change"], "elidable": true,
      "theme": ["quantity:*"], "required": ["theme", "unit"],
      "roles": { "unit": { "preps": ["in", "to", "as", "into"], "types": ["unit"] } },
      "words_pt": ["converter", "converte", "converta", "passar", "passa"], "label_pt": "Converter" },
    { "name": "lookup", "label": "Look up", "words": ["lookup", "look up", "get", "find"], "elidable": true,
      "theme": ["property"], "required": ["theme", "of"],
      "roles": { "of": { "preps": ["of", "for"], "types": ["mineral", "country"] }, "unit": { "preps": ["in", "as"], "types": ["unit"] } },
      "words_pt": ["consultar", "consulta", "buscar", "busca"], "label_pt": "Consultar" },
    { "name": "plot", "label": "Plot", "words": ["plot", "draw", "show", "display"], "elidable": true,
      "theme": ["plot"], "required": ["theme", "of"],
      "roles": { "of": { "preps": ["of", "for"], "types": ["variable"] }, "scale": { "preps": ["in", "on", "with"], "types": ["scale"] } },
      "words_pt": ["plotar", "plota", "mostrar", "mostra", "desenhar", "desenha"], "label_pt": "Plotar" },
    { "name": "define", "label": "Define", "words": ["define", "explain", "describe"], "elidable": true,
      "theme": ["term", "mineral"], "required": ["theme"], "roles": {},
      "words_pt": ["definir", "define", "defina", "explicar", "explica", "descrever", "descreve"], "label_pt": "Definir" },
    { "name": "list", "label": "List", "words": ["list", "rank"], "elidable": true,
      "theme": ["country"], "required": ["theme"],
      "roles": { "by": { "preps": ["by"], "types": ["property"] } },
      "words_pt": ["listar", "lista", "ordenar", "ordena"], "label_pt": "Listar" },
    { "name": "open", "label": "Open", "words": ["open", "load"],
      "theme": ["table"], "required": ["theme"], "roles": {},
      "words_pt": ["abrir", "abre", "carregar", "carrega"], "label_pt": "Abrir" },
    { "name": "identify", "label": "Identify", "words": ["identify", "key out", "id"],
      "theme": ["mineral"], "required": ["theme"], "roles": {},
      "words_pt": ["identificar", "identifica"], "label_pt": "Identificar" },
    { "name": "timer", "label": "Set a timer", "words": ["set a timer", "start a timer", "timer"],
      "theme": [], "required": ["for"],
      "roles": { "for": { "preps": ["for", "of"], "types": ["quantity:time"] } },
      "words_pt": ["cronômetro", "cronometro", "timer", "temporizador"], "label_pt": "Cronômetro" },
    { "name": "export", "label": "Export", "words": ["export", "save"],
      "theme": [], "required": ["as"],
      "roles": { "as": { "preps": ["as", "to"], "types": ["format"] } },
      "words_pt": ["exportar", "exporta", "salvar", "salva"], "label_pt": "Exportar" }
  ],
  "inherit": [],
  "echoOrder": ["of", "unit", "by", "scale", "for", "as"],
  "roleLabels_pt": { "of": "de", "unit": "unidade", "by": "por", "scale": "escala", "for": "duração", "as": "como" },
  "scales": {}
}
