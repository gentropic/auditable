{
  "name": "@gcu/adder",
  "version": "0.3.1",
  "description": "Python-in-JavaScript. AST parser + tree-walking evaluator in pure JS, no Wasm. Standalone library — Python values are JS values (no FFI boundary). Used by Auditable as a cell type.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./air": {
      "types": "./src/air.d.ts",
      "default": "./src/air.js"
    },
    "./vfs": {
      "types": "./src/vfs.d.ts",
      "default": "./src/vfs.js"
    },
    "./parse": "./src/parse.js",
    "./eval": "./src/eval.js",
    "./builtins": "./src/builtins.js",
    "./runtime": "./src/runtime.js",
    "./tag": "./src/tag.js",
    "./cell": "./src/cell.js",
    "./highlight": "./src/highlight.js",
    "./register": "./src/register.js",
    "./bundled": "./index.js",
    "./batteries": "./batteries.js",
    "./package.json": "./package.json"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "pylib",
    "index.js",
    "batteries.js",
    "LICENSE",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "node build.js"
  },
  "peerDependencies": {
    "@gcu/air": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@gcu/air": {
      "optional": true
    }
  },
  "keywords": [
    "python",
    "interpreter",
    "adder",
    "micropython",
    "dsl",
    "language",
    "ast",
    "auditable",
    "gcu"
  ],
  "license": "MIT",
  "author": "Arthur Endlein Correia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentropic/auditable.git",
    "directory": "ext/adder"
  },
  "homepage": "https://github.com/gentropic/auditable/tree/main/ext/adder",
  "bugs": {
    "url": "https://github.com/gentropic/auditable/issues"
  },
  "auditable": {
    "kind": "extension",
    "exampleOf": "language pack — declares its language as DATA (gcu.languages) so the notebook's cell-type picker can offer it cold; index.js registers the cell type + tag + AIR lowerer on first load (cold→hot)."
  },
  "gcu": {
    "languages": [
      {
        "cellType": "adder",
        "tag": "adder",
        "label": "Python (adder)",
        "aliases": [
          "mpy"
        ]
      }
    ]
  }
}
